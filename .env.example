# Copy to .env and adjust.  `docker compose` reads .env automatically.

# Port the web UI is published on (http://localhost:<MF_PORT>)
MF_PORT=8000

# How many Volatility jobs may run concurrently.
# Memory analysis is CPU + IO heavy; 2-4 is sensible on a laptop.
MF_WORKERS=2

# Maximum accepted upload size in GiB (streamed to disk, not buffered in RAM)
MF_MAX_UPLOAD_GB=64

# Used to sign download/report tokens.  Change it.
MF_SECRET=please-change-this-to-something-random

# Timezone used for timestamps in the UI and reports
TZ=UTC
